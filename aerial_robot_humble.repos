repositories:
  ros2_numpy:
    type: git
    url: "https://github.com/Box-Robotics/ros2_numpy.git"
    version: "humble"
    local-name: "ros2_numpy"

  kalman_filter:
    type: git
    url: "https://github.com/ut-dragon-lab/kalman_filter.git"
    version: "ros2"
    local-name: "kalman_filter"
    
  aerial_robot_nerve:
    type: git
    url: "https://github.com/ut-dragon-lab/aerial_robot_nerve.git"
    version: "master"
    local-name: "aerial_robot_nerve"

  gz_ros2_control:
    type: git
    url: "https://github.com/ros-controls/gz_ros2_control.git"
    # Humble branch, built against the installed Gazebo Harmonic with GZ_VERSION=harmonic.
    version: "c88a5fd9170af120c263c1201f0744a40f93d673"
